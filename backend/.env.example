PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database & Cache & Search
DATABASE_URL="postgresql://postgres:password@localhost:5432/reachinbox?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
ELASTICSEARCH_URL=http://localhost:9200

# Auth & JWT
JWT_SECRET=super_secret_reachinbox_jwt_key_change_in_prod
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Worker & Rate Limiter Defaults
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
DEFAULT_MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Slack OAuth App Credentials
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback