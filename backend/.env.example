
# ==========================================
# REACHINBOX - BACKEND ENVIRONMENT VARIABLES
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ==========================================
# DATABASE, CACHE & SEARCH
# ==========================================

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:password@localhost:5432/reachinbox?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200

# ==========================================
# AUTHENTICATION & JWT
# ==========================================

JWT_SECRET=super_secret_reachinbox_jwt_key_change_in_prod

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# ==========================================
# MAILTRAP CONFIGURATION
# ==========================================

# Optional: Mailtrap API Integration
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=

# ==========================================
# EMAIL WORKER & RATE LIMITING
# ==========================================

# Number of concurrent background workers
WORKER_CONCURRENCY=5

# Minimum delay between emails (milliseconds)
MIN_DELAY_BETWEEN_EMAILS_MS=2000

# Maximum emails per sender per hour
DEFAULT_MAX_EMAILS_PER_HOUR_PER_SENDER=200

# ==========================================
# SLACK OAUTH INTEGRATION
# ==========================================

SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
